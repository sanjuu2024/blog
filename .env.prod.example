# 正式 Compose 输入模板。复制到服务器仓库外的 .env.prod，替换全部 CHANGE_ME 和示例域名。
# 父目录权限 700，文件权限 600；不要提交真实值。Compose 使用 --env-file 显式加载。
# 仅配合 compose.prod.yaml；首次管理员初始化额外叠加 compose.bootstrap.yaml。
COMPOSE_PROJECT_NAME=blog-prod

# 本次计划发布版本；部署前构建，正式发布后不覆盖同一版本标签。
BLOG_POSTGRES_IMAGE=blog-postgres:v1.0.0
BLOG_BACKEND_IMAGE=blog-backend:v1.0.0
BLOG_NGINX_IMAGE=blog-nginx:v1.0.0

# 当前 PostgreSQL 初始化、Flyway 和后端数据源共用下列账号，尚未实现管理 / 应用账号分离。
# Compose 自动生成内部数据库 URL，不需要另填 BLOG_DB_URL / BLOG_DB_USERNAME / BLOG_DB_PASSWORD。
# 两个密码分别运行 openssl rand -hex 24 生成；只在创建空数据卷时初始化数据库账号密码。
POSTGRES_DB=blog_prod
POSTGRES_USER=blog_owner
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_RANDOM_HEX
REDIS_PASSWORD=CHANGE_ME_DIFFERENT_REDIS_RANDOM_HEX
BLOG_REDIS_DATABASE=0

# 使用 openssl rand -base64 48 生成，不能使用下方占位文本。
BLOG_JWT_SECRET=CHANGE_ME_BASE64_48_RANDOM_BYTES

BLOG_APP_NAME=青禾边
BLOG_SITE_URL=https://blog.example.com
BLOG_DESC=CHANGE_ME_SITE_DESCRIPTION
# 供其他网站引用的本站头像，使用 public 静态资源，避免受 OSS 防盗链影响。
BLOG_LOGO_URL=https://blog.example.com/img/site-avatar.jpg

# 与独立共享入口的正式网络、模板中的上游别名及可信入口 IP 保持一致。
BLOG_EDGE_NETWORK=blog-prod-edge
BLOG_WEB_ALIAS=blog-prod-web
BLOG_INGRESS_IP=172.30.10.2

# 正式 OSS bucket 的写入凭据；不要使用 DNS 验证或证书部署身份。
BLOG_OBJECT_STORAGE_PROVIDER=aliyun
BLOG_OBJECT_STORAGE_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
BLOG_OBJECT_STORAGE_BUCKET=CHANGE_ME_PRODUCTION_IMAGE_BUCKET
BLOG_OBJECT_STORAGE_ACCESS_KEY_ID=CHANGE_ME_IMAGE_UPLOAD_KEY_ID
BLOG_OBJECT_STORAGE_ACCESS_KEY_SECRET=CHANGE_ME_IMAGE_UPLOAD_KEY_SECRET
BLOG_OBJECT_STORAGE_PUBLIC_BASE_URL=https://img.example.com

# 使用 Resend 已验证发件域；替换 mail.example.com，显示名称可自行修改。
BLOG_MAIL_ENABLED=true
BLOG_MAIL_FROM="青禾边 <no-reply@mail.example.com>"
BLOG_MAIL_FRONTEND_BASE_URL=https://blog.example.com
BLOG_SMTP_HOST=smtp.resend.com
BLOG_SMTP_PORT=587
BLOG_SMTP_USERNAME=resend
BLOG_SMTP_PASSWORD=CHANGE_ME_RESEND_SENDING_API_KEY
BLOG_SMTP_AUTH=true
BLOG_SMTP_STARTTLS=true
BLOG_SMTP_CONNECTION_TIMEOUT=5000
BLOG_SMTP_READ_TIMEOUT=10000
BLOG_SMTP_WRITE_TIMEOUT=10000

# 正式 Cloudflare Turnstile 配置，hostname 不包含协议和路径。
BLOG_TURNSTILE_ENABLED=true
BLOG_TURNSTILE_SECRET_KEY=CHANGE_ME_TURNSTILE_SECRET_KEY
BLOG_TURNSTILE_EXPECTED_HOSTNAME=blog.example.com
BLOG_TURNSTILE_EXPECTED_ACTION=guest_message
VITE_TURNSTILE_SITE_KEY=CHANGE_ME_TURNSTILE_SITE_KEY

# 前端构建参数：首次正式公开运行时间，ISO 8601；后续发布不要重置。
VITE_SITE_LAUNCHED_AT=CHANGE_ME_FIRST_PUBLIC_TIME_ISO8601

# 仅首次全新数据库 bootstrap 使用；从备份恢复时跳过 bootstrap。
# 邮箱必须由部署者控制；密码仍通过一次性临时文件输入，成功后删除该文件。
BLOG_BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
BLOG_BOOTSTRAP_ADMIN_NICKNAME=站点管理员
BLOG_BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
BLOG_BOOTSTRAP_ADMIN_PASSWORD_PATH=/opt/blog-platform/production/bootstrap-password
