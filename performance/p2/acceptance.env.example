# Copy to /opt/blog-platform/acceptance/.env.acceptance; replace every CHANGE_ME value.
# No production credentials. This file only documents inputs, not actual server secrets.
# Production Compose uses the repository-root .env.prod.example instead.
COMPOSE_PROJECT_NAME=blog-p2-acceptance
BLOG_POSTGRES_IMAGE=blog-postgres:p2-acceptance
BLOG_BACKEND_IMAGE=blog-backend:p2-acceptance
BLOG_NGINX_IMAGE=blog-nginx:p2-acceptance
POSTGRES_DB=blog_p2_performance
POSTGRES_USER=blog_p2
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_HEX
REDIS_PASSWORD=CHANGE_ME_DIFFERENT_RANDOM_HEX
BLOG_JWT_SECRET=CHANGE_ME_BASE64_48_RANDOM_BYTES
BLOG_REDIS_DATABASE=2

BLOG_APP_NAME=Blog Acceptance
BLOG_SITE_URL=https://staging.example.com
BLOG_DESC=P2独立部署验收
BLOG_LOGO_URL=https://staging.example.com/favicon.svg
BLOG_MAIL_FRONTEND_BASE_URL=https://staging.example.com
BLOG_MAIL_ENABLED=false
BLOG_EDGE_NETWORK=blog-staging-edge
BLOG_WEB_ALIAS=blog-staging-web
BLOG_INGRESS_IP=172.30.11.2
ACCEPTANCE_BACKEND_PORT=18080

# Dedicated test bucket credentials; API load tests do not upload objects.
BLOG_OBJECT_STORAGE_PROVIDER=aliyun
BLOG_OBJECT_STORAGE_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
BLOG_OBJECT_STORAGE_BUCKET=CHANGE_ME_TEST_BUCKET
BLOG_OBJECT_STORAGE_ACCESS_KEY_ID=CHANGE_ME_TEST_KEY_ID
BLOG_OBJECT_STORAGE_ACCESS_KEY_SECRET=CHANGE_ME_TEST_KEY_SECRET
BLOG_OBJECT_STORAGE_PUBLIC_BASE_URL=https://CHANGE_ME_TEST_IMAGE_DOMAIN

# Disabled for read/application tests. This does NOT pass the Turnstile acceptance scenario.
BLOG_TURNSTILE_ENABLED=false
BLOG_TURNSTILE_SECRET_KEY=disabled-for-read-performance
BLOG_TURNSTILE_EXPECTED_HOSTNAME=staging.example.com
BLOG_TURNSTILE_EXPECTED_ACTION=guest_message
VITE_TURNSTILE_SITE_KEY=disabled-for-read-performance
VITE_SITE_LAUNCHED_AT=2026-11-04T00:00:00+08:00

BLOG_BOOTSTRAP_ADMIN_USERNAME=acceptance-admin
BLOG_BOOTSTRAP_ADMIN_NICKNAME=P2验收管理员
BLOG_BOOTSTRAP_ADMIN_EMAIL=acceptance-admin@example.com
BLOG_BOOTSTRAP_ADMIN_PASSWORD_PATH=/opt/blog-platform/acceptance/secrets/bootstrap-password
