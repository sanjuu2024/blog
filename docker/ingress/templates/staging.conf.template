server {
    listen 443 ssl;
    http2 on;
    server_name ${INGRESS_STAGING_HOST};

    ssl_certificate /etc/letsencrypt/live/${INGRESS_STAGING_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${INGRESS_STAGING_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 12m;
    add_header X-Robots-Tag "noindex, nofollow" always;

    resolver 127.0.0.11 valid=10s ipv6=off;
    location / {
        # Resolve on request so the entrypoint also starts while a project is stopped.
        set $project_upstream blog-staging-web:80;
        proxy_pass http://$project_upstream;
        proxy_hide_header X-Robots-Tag;
        include /etc/nginx/snippets/proxy.conf;
    }
}
