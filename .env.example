# 本地开发与通用变量参考。正式 Compose 请使用根目录 .env.prod.example。
BLOG_DB_URL=jdbc:postgresql://localhost:5432/blog_db
BLOG_APP_NAME=
BLOG_SITE_URL=
BLOG_DESC=
BLOG_LOGO_URL=
# 直接从 backend 目录启动时使用前端源模板；生产 Compose 指定共享构建模板。
BLOG_SEO_HTML_TEMPLATE=file:../frontend/index.html
# 业务连接使用受限账号，Flyway 使用独立管理连接，启动时自动创建应用账号并授权。
POSTGRES_APP_USERNAME=blog_dev_app
POSTGRES_APP_PASSWORD=
POSTGRES_ADMIN_USERNAME=sanjuu
POSTGRES_ADMIN_PASSWORD=
BLOG_JWT_SECRET=
BLOG_REDIS_HOST=localhost
BLOG_REDIS_PORT=6379
BLOG_REDIS_PASSWORD=
BLOG_REDIS_DATABASE=0

BLOG_TEST_DB_URL=jdbc:postgresql://localhost:5432/blog_test
POSTGRES_TEST_APP_USERNAME=blog_test_app
POSTGRES_TEST_APP_PASSWORD=
POSTGRES_TEST_ADMIN_USERNAME=sanjuu
POSTGRES_TEST_ADMIN_PASSWORD=
BLOG_TEST_JWT_SECRET=
BLOG_TEST_REDIS_DATABASE=1

BLOG_OBJECT_STORAGE_PROVIDER=aliyun
BLOG_OBJECT_STORAGE_ENDPOINT=
BLOG_OBJECT_STORAGE_BUCKET=
BLOG_OBJECT_STORAGE_ACCESS_KEY_ID=
BLOG_OBJECT_STORAGE_ACCESS_KEY_SECRET=
BLOG_OBJECT_STORAGE_PUBLIC_BASE_URL=https://img.example.com

BLOG_MAIL_ENABLED=false
BLOG_MAIL_FROM="青禾边 <no-reply@mail.ccsanjuu.com>"
BLOG_MAIL_FRONTEND_BASE_URL=http://localhost:5173
BLOG_SMTP_HOST=smtp.resend.com
BLOG_SMTP_PORT=587
BLOG_SMTP_USERNAME=resend
BLOG_SMTP_PASSWORD=
BLOG_SMTP_AUTH=true
BLOG_SMTP_STARTTLS=true
BLOG_SMTP_CONNECTION_TIMEOUT=5000
BLOG_SMTP_READ_TIMEOUT=10000
BLOG_SMTP_WRITE_TIMEOUT=10000

BLOG_TURNSTILE_ENABLED=true
BLOG_TURNSTILE_SECRET_KEY=
BLOG_TURNSTILE_EXPECTED_HOSTNAME=localhost
BLOG_TURNSTILE_EXPECTED_ACTION=guest_message

VITE_TURNSTILE_SITE_KEY=
VITE_SITE_LAUNCHED_AT=2026-10-29T00:00:00+08:00

BLOG_BOOTSTRAP_ADMIN_USERNAME=
BLOG_BOOTSTRAP_ADMIN_NICKNAME=站点管理员
BLOG_BOOTSTRAP_ADMIN_EMAIL=
BLOG_BOOTSTRAP_ADMIN_PASSWORD_PATH=./deploy/bootstrap-admin-password.txt
# 本次正式版本的镜像标签，部署前按确定的源码构建。
BLOG_POSTGRES_IMAGE=blog-postgres:v1.0.0
BLOG_BACKEND_IMAGE=blog-backend:v1.0.0
BLOG_NGINX_IMAGE=blog-nginx:v1.0.0

# Production Compose joins networks created by the independent shared ingress.
BLOG_EDGE_NETWORK=blog-prod-edge
BLOG_WEB_ALIAS=blog-prod-web
BLOG_INGRESS_IP=172.30.10.2
