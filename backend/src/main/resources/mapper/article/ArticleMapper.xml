<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ccsanjuu.blog.modules.article.mapper.ArticleMapper">
    <select id="getArticleCountByCategoryIds" resultType="com.ccsanjuu.blog.modules.article.model.bo.CategoryArticleCountBO">
        select category_id as categoryId, count(id) as articleCount
        from blog_article
        where category_id in
        <foreach collection="categoryIds" item="categoryId" separator="," open="(" close=")">
            #{categoryId}
        </foreach>
        <if test="published != null and published">
            and status = 'PUBLISHED'
        </if>
        group by category_id
    </select>
</mapper>